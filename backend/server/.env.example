# backend/server/.env.example
# -----------------------------------------------------------------------------
# Copy this file to ".env" (same folder) and fill in real values.
# ".env" is already excluded from git via the root .gitignore, so your real
# credentials won't accidentally get committed/pushed.
#
# See server.js and readme.txt for how to generate a Gmail App Password.

GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password

# Optional: which port the server listens on (defaults to 5000 if unset).
PORT=5000
